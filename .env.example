# Ortam değişkeni örneği.
# Bu dosyayı ".env" adıyla kopyalayıp değerleri kendinize göre düzenleyiniz.
# .env dosyası .gitignore ile hariç tutulmuştur, depoya gönderilmez.
#
# Hiçbiri tanımlanmazsa uygulama geliştirme varsayılanlarıyla çalışır;
# kurum sunucusuna kurulumda SECRET_KEY mutlaka değiştirilmelidir.

# Oturum çerezlerini imzalamak için kullanılır.
# Üretim için rastgele bir değer üretiniz:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-in-production

# Varsayılan olarak instance/app.db (SQLite) kullanılır.
# PostgreSQL örneği:
#   DATABASE_URL=postgresql://kullanici:sifre@localhost:5432/talep_takip
DATABASE_URL=
